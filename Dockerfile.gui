# ------------------------------------------------------
# WebRTC Screen Share GUI – Container (needs X server)
# ------------------------------------------------------
# This image runs the Tkinter-based webrtc_gui.py. It relies on the host
# X11 display for all rendering and therefore mounts /tmp/.X11-unix and
# forwards the DISPLAY environment variable via docker-compose.
# ------------------------------------------------------
FROM python:3.12-slim

# ---------- Native libraries required by the GUI ----------
RUN apt-get update && apt-get install -y \
        python3-tk \
        libx11-6 libxext6 libxrender1 libxrandr2 libxi6 \
        libgl1 \
        libglib2.0-0 \
        libasound2-dev portaudio19-dev \
        build-essential python3-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ---------- Project setup ----------
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

CMD ["python", "webrtc_gui.py"]
